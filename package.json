{
  "name": "3d-colab-recommendations",
  "version": "0.1.0",
  "private": false,
  "description": "Marketplace 3D lite com sistema de recomendação content-based — laboratório da pós-graduação",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "WATCHPACK_POLLING=true next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "migrate": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "assets:stl": "tsx src/scripts/generate-sample-stls.ts",
    "db:setup": "prisma migrate dev && npm run seed",
    "recommendations:train": "tsx src/scripts/train-recommendation-model.ts",
    "semver:calc": "tsx scripts/calculate-semver.ts",
    "feature:new": "bash scripts/new-feature.sh",
    "studio": "prisma studio",
    "test": "jest",
    "test:unit": "jest --testPathPattern=tests/unit",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:setup": "bash docker/setup.sh",
    "docker:reset": "docker compose down -v",
    "docker:logs": "docker compose logs -f app"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.6",
    "@tensorflow/tfjs": "^4.22.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "lucide-react": "^0.284.0",
    "next": "^14.2.29",
    "next-auth": "^4.24.5",
    "next-themes": "^0.3.0",
    "prisma": "^5.10.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "^0.33.5",
    "tailwind-merge": "^1.14.0",
    "tailwindcss-animate": "^1.0.0",
    "three": "^0.176.0",
    "three-stdlib": "^2.36.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.6.2",
    "@types/react": "^18.2.22",
    "@types/react-dom": "^18.2.7",
    "@types/three": "^0.176.0",
    "autoprefixer": "^10.4.7",
    "eslint": "^8.49.0",
    "eslint-config-next": "^14.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.14",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.2.2"
  }
}
